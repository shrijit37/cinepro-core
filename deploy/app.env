# Runtime env for the Dokploy compose app `cinepro-core`.
# CI re-asserts this block through compose.saveEnvironment on every deploy
# (Dokploy's provider sync can clear an app env block).
# __TMDB_API_KEY__ is substituted by CI from Doppler platform/prd
# (CINEPRO_TMDB_API_KEY) — no secret value is stored in git.
#
# This file is also the compose env (`env_file: .env` for cinepro-core, and the
# source of `${...}` interpolation for lane-egress below).
PORT=3210
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_URL=https://cinepro-core.shrijit.tech
CACHE_TYPE=memory
# PoToken provider service in compose.prod.yml; empty disables PoTokens.
YTDLP_POT_URL=http://bgutil-provider:4416
# Bearer token for the lane-egress sidecar's control plane. CI substitutes this
# from Doppler platform/prd CINEPRO_LANE_TOKEN (a random 48-hex value) so no
# value is stored in git — the repo is public and run_cmd on that control plane
# is root-level execution. It is scoped to this stack: no published port, and
# nothing outside the compose stack ever sees it.
LANE_TOKEN=__LANE_TOKEN__
CORS_ORIGIN=*
STREMIO_ADDON=false
MCP_ENABLED=false
INTERNAL_DEBUG=false
TMDB_CACHE_TTL=86400
TMDB_API_KEY=__TMDB_API_KEY__
